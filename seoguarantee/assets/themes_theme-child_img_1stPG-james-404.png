					_l	  = _this.find('.elementor-image-box-img > a').attr('href'),
					_l	  = _l ? _l : _this.find('.elementor-image-box-title > a').attr('href');

					if(_l) {
						_this.find('.elementor-image-box-wrapper').append('<a href="'+_l+'" class="learn-more">Learn More</a>');
					}


			});

			
		}
		
	});

</script>
